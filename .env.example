# PayFlow environment configuration — placeholders only.
# Copy to .env and fill in real values locally. Never commit .env.
#
# This file grows incrementally as each milestone introduces real
# configuration (PostgreSQL in Milestone 4, Paystack in Milestone 7,
# RabbitMQ in Milestone 9, etc.) — it intentionally does not list
# variables that no code reads yet.

APP_ENV=development

# api-gateway
GATEWAY_PORT=8080
ORDER_SERVICE_ADDR=localhost:9090

# order-service
ORDER_GRPC_PORT=9090
ORDER_DATABASE_URL=postgres://payflow:payflow@localhost:5433/payflow_order?sslmode=disable

# payment-service
PAYMENT_GRPC_PORT=9091
PAYMENT_DATABASE_URL=postgres://payflow:payflow@localhost:5433/payflow_payment?sslmode=disable
